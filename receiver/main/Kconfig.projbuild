menu "Wireless DAP receiver"

config WIRELESS_DAP_LED_GPIO
    int "WS2812 data GPIO"
    range 0 48
    default 48

config WIRELESS_DAP_PAIR_ID
    hex "Pair identifier"
    default 0x57444150
    help
        Both boards must use the same value. It separates nearby probe pairs.

config WIRELESS_DAP_WIFI_CHANNEL
    int "ESP-NOW Wi-Fi channel"
    range 1 13
    default 6

config WIRELESS_DAP_TX_DELAY_MS
    int "ESP-NOW TX pacing delay (ms)"
    range 0 20
    default 2
    help
        Delay after an accepted ESP-NOW frame. Keep 2 ms for the original
        baseline; use 0 or 1 ms only after checking send failures.

config WIRELESS_DAP_ESPNOW_PHY_RATE
    int "ESP-NOW peer PHY rate"
    range 0 3
    default 0
    help
        0: driver default, 1: 11 Mbps, 2: HT20 MCS2, 3: HT20 MCS3.

config WIRELESS_DAP_DAP_RETRY_MS
    int "DAP response retry interval (ms)"
    range 5 200
    default 45

config WIRELESS_DAP_DIAGNOSTICS
    bool "Enable wireless performance diagnostics"
    default n
    help
        Log DAP latency and a five-second wireless link statistics summary.

config WIRELESS_DAP_UART_TX_GPIO
    int "Target UART TX GPIO"
    range 0 48
    default 17

config WIRELESS_DAP_UART_RX_GPIO
    int "Target UART RX GPIO"
    range 0 48
    default 18

config WIRELESS_DAP_UART_BAUD
    int "Initial target UART baud rate"
    range 1200 3000000
    default 115200

config WIRELESS_DAP_SWD_CLK_GPIO
    int "Target SWCLK GPIO"
    range 0 48
    default 9

config WIRELESS_DAP_SWD_DEFAULT_CLOCK_HZ
    int "Default SWD clock (Hz)"
    range 100000 8000000
    default 1000000
    help
        Used until the host sends DAP_SWJ_Clock. Validate 2-4 MHz on the
        target and wiring before selecting a higher value.

config WIRELESS_DAP_SWD_IO_GPIO
    int "Target SWDIO GPIO"
    range 0 48
    default 10

config WIRELESS_DAP_RESET_GPIO
    int "Target nRESET GPIO"
    range 0 48
    default 4

endmenu
