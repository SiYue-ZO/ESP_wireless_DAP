menu "Wireless DAP transmitter"

config WIRELESS_DAP_LED_GPIO
    int "WS2812 data GPIO"
    range 0 48
    default 48

config WIRELESS_DAP_PAIR_ID
    hex "Pair identifier"
    default 0x57444150
    help
        Both boards must use the same value. It separates nearby probe pairs.

config WIRELESS_DAP_WIFI_CHANNEL
    int "ESP-NOW Wi-Fi channel"
    range 1 13
    default 6

config WIRELESS_DAP_PROTOCOL_VERSION
    int "Wireless protocol version"
    range 1 2
    default 1
    help
        Version 1 is the stable 64-byte HID baseline. Version 2 enables the
        capability-negotiation skeleton; both boards must use the same value.

config WIRELESS_DAP_V2_PACKET_WINDOW
    int "Protocol v2 packet window"
    range 1 1
    default 1
    depends on WIRELESS_DAP_PROTOCOL_VERSION = 2
    help
        The first v2 implementation is ordered and uses window 1.

config WIRELESS_DAP_TX_DELAY_MS
    int "ESP-NOW TX pacing delay (ms)"
    range 0 20
    default 2
    help
        Delay after an accepted ESP-NOW frame. Keep 2 ms for the original
        baseline; use 0 or 1 ms only after checking send failures.

config WIRELESS_DAP_ESPNOW_PHY_RATE
    int "ESP-NOW peer PHY rate"
    range 0 3
    default 0
    help
        0: driver default, 1: 11 Mbps, 2: HT20 MCS2, 3: HT20 MCS3.

config WIRELESS_DAP_DAP_RETRY_MS
    int "DAP response retry interval (ms)"
    range 5 200
    default 45

config WIRELESS_DAP_DIAGNOSTICS
    bool "Enable wireless performance diagnostics"
    default n
    help
        Log DAP latency and a five-second wireless link statistics summary.

endmenu
